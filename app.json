{
  "expo": {
    "name": "AgriFresh",
    "slug": "agrifresh",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "agrifresh",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agrifresh.app"
    },
    "android": {
      "package": "com.agrifresh.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6EDDF"
      }
    },
    "extra": {
      "eas": {
        "projectId": "0b3bdd83-a623-4903-9ceb-051c4173e648"
      }
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "AgriFresh utilise la caméra pour scanner le QR code du point de livraison.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
