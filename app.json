{
  "expo": {
    "name": "AgriFresh",
    "slug": "agrifresh",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "agrifresh",
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "AgriFresh",
      "themeColor": "#24543B"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agrifresh.app"
    },
    "android": {
      "package": "com.agrifresh.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#24543B"
      }
    },
    "extra": {
      "eas": {
        "projectId": "0b3bdd83-a623-4903-9ceb-051c4173e648"
      }
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "AgriFresh utilise la caméra pour scanner le QR code du point de livraison.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#24543B",
          "defaultChannel": "alerts"
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
