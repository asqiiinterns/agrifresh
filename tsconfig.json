{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "android",
    "dist",
    "src",
    "vite.config.ts",
    "capacitor.config.ts",
    "tsconfig.app.json",
    "tsconfig.node.json"
  ]
}
